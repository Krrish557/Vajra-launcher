<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_cyber"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cat_terminal"
            app:tint="@color/vajra_accent_cyan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:letterSpacing="0.05"
            android:text="TACTICAL EXECUTION REPORT"
            android:textColor="@color/vajra_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_installed"
            android:letterSpacing="0.04"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="SUCCESS"
            android:textColor="@color/vajra_badge_installed_text"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/resultToolInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tool: Nmap v7.95 • Environment: Debian GNU/Linux"
        android:textColor="@color/vajra_text_secondary"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/vajra_border_dark" />

    <!-- Metadata Row: Target, Exit Code, Duration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_elevated"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET"
                android:textColor="@color/vajra_text_tertiary"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resultTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="127.0.0.1"
                android:textColor="@color/vajra_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXIT CODE"
                android:textColor="@color/vajra_text_tertiary"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resultExitCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0"
                android:textColor="@color/vajra_accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION"
                android:textColor="@color/vajra_text_tertiary"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/resultDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="1.2s"
                android:textColor="@color/vajra_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Terminal Output Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.04"
        android:text="STANDARD OUTPUT"
        android:textColor="@color/vajra_text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Terminal Output Scroll Box (capped height to avoid exceeding screen) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_code_box"
        android:scrollbars="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal">

            <TextView
                android:id="@+id/txtExecutionOutput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:padding="8dp"
                android:text="[stdout output]"
                android:textColor="@color/vajra_text_code"
                android:textSize="10sp" />
        </HorizontalScrollView>
    </ScrollView>

    <!-- Error/Stderr Notice (if any, hidden by default) -->
    <TextView
        android:id="@+id/txtExecutionError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/vajra_badge_error_text"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Footer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCopyResult"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingHorizontal="14dp"
            android:text="COPY OUTPUT"
            android:textColor="@color/vajra_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDismissResult"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingHorizontal="16dp"
            android:text="DISMISS"
            android:textColor="@color/color_primary_btn_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
