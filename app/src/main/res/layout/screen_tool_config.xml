<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vajra_bg_dark"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Top Header: Back & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/toolConfigBackBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/toolConfigTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:letterSpacing="0.05"
                android:text="Nmap - Advanced"
                android:textColor="@color/vajra_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Field 1: Target -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_target"
            android:textColor="@color/vajra_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputTarget"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. 192.168.1.0/24"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:textColor="@color/vajra_text_primary"
            android:textColorHint="@color/vajra_text_tertiary"
            android:textSize="13sp" />

        <!-- Field 2: Scan Type (Selector Dropdown) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_scan_type"
            android:textColor="@color/vajra_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/spinnerScanType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/selectedScanTypeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SYN Scan (-sS)"
                android:textColor="@color/vajra_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="@color/vajra_text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Field 3: Ports -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_ports"
            android:textColor="@color/vajra_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/inputPorts"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. 1-1000"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:textColor="@color/vajra_text_primary"
            android:textColorHint="@color/vajra_text_tertiary"
            android:textSize="13sp" />

        <!-- Checkboxes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <!-- Checkbox 1: Service Detection -->
            <LinearLayout
                android:id="@+id/checkServiceDetection"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/checkServiceDetectionIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_checkbox_checked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/opt_service_detection"
                    android:textColor="@color/vajra_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Checkbox 2: OS Detection -->
            <LinearLayout
                android:id="@+id/checkOsDetection"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/checkOsDetectionIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_checkbox_unchecked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/opt_os_detection"
                    android:textColor="@color/vajra_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Checkbox 3: Aggressive Scan -->
            <LinearLayout
                android:id="@+id/checkAggressiveScan"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/checkAggressiveScanIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_checkbox_unchecked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/opt_aggressive_scan"
                    android:textColor="@color/vajra_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- More Options Accordion -->
        <LinearLayout
            android:id="@+id/btnMoreOptions"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_more_options"
                android:textColor="@color/vajra_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/moreOptionsChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="@color/vajra_text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- More Options Expanded Content (hidden by default) -->
        <LinearLayout
            android:id="@+id/moreOptionsExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_cyber"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timing template (-T4)"
                android:textColor="@color/vajra_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ping options: -Pn (No ping)"
                android:textColor="@color/vajra_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Run Scan Action Button -->
        <LinearLayout
            android:id="@+id/btnRunScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play"
                app:tint="@color/color_primary_btn_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.05"
                android:text="@string/action_run_scan"
                android:textColor="@color/color_primary_btn_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
